# Google Gemini API Key for BeatPilot AI DJ
# Get a free API key at: https://aistudio.google.com/
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# Model choice: gemini-2.0-flash (recommended for ~300ms sub-second response) or gemini-1.5-flash
GEMINI_MODEL=gemini-2.0-flash

# Local Ollama model choice (defaults to lightweight qwen2.5:1.5b for fast CPU inference)
# OLLAMA_MODEL=qwen2.5:1.5b


# Where song audio and search come from: third-party YouTube front-ends that fetch from YouTube on
# their own servers, so this laptop never contacts YouTube (and its IP can't be blocked for it).
# Comma-separated, tried in order: invidious:<url> or piped:<url>. Public instances come and go;
# a self-hosted Invidious is the most reliable. Leave unset to use the built-in list.
# AUDIO_SOURCES=invidious:https://yt.chocolatemoo53.com,piped:https://api.piped.private.coffee
